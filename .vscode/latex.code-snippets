{
  "Figure (column)": {
    "scope": "latex",
    "prefix": "fig",
    "body": [
      "\\begin{figure}[t]",
      "  \\centering",
      "  \\includegraphics[width=\\columnwidth]{${1:file}}",
      "  \\caption{${2:Caption.}}",
      "  \\label{fig:${3:label}}",
      "\\end{figure}"
    ]
  },
  "Table (booktabs)": {
    "scope": "latex",
    "prefix": "tab",
    "body": [
      "\\begin{table}[t]",
      "  \\centering",
      "  \\caption{${1:Caption.}}",
      "  \\label{tab:${2:label}}",
      "  \\small",
      "  \\begin{tabular}{@{}lcc@{}}",
      "    \\toprule",
      "    ${3:A} & ${4:B} & ${5:C} \\\\\\\\",
      "    \\midrule",
      "    $0",
      "    \\bottomrule",
      "  \\end{tabular}",
      "\\end{table}"
    ]
  },
  "TODO": { "scope": "latex", "prefix": "todo", "body": "\\TODO{$1}" }
}
